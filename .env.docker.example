# 对外暴露端口（默认 8080，如有宿主机 Nginx/Caddy 反代可改或保持 127.0.0.1 映射）
APP_PORT=8080

# SQLite 数据库路径（容器内持久化卷目录）
CET_DB_PATH=/app/data/cet_agent.db

# 管理员用户名（逗号分隔；首位注册用户也会自动成为管理员）
CET_ADMIN_USERNAMES=

# MinerU Cloud API（可选，用于 PDF 真题云端解析）
CET_MINERU_API_KEY=
CET_MINERU_BASE_URL=https://mineru.net/api/v4

# OpenAI 兼容模型配置（必填）
CET_MODEL_BASE_URL=https://api.openai.com/v1
CET_MODEL_API_KEY=your_api_key_here
CET_MODEL_NAME=gpt-4o-mini

# 会话加密密钥（必填，生产环境请替换为随机强密码，如 openssl rand -hex 32）
CET_SESSION_SECRET_KEY=change_this_session_secret

# 若通过纯 HTTP 访问（如 http://服务器IP:8080）请保持 false；若前端配置了 HTTPS 域名反代建议设为 true
CET_COOKIE_SECURE=false
CET_AUTH_SESSION_CLEANUP_PROBABILITY=0.01

# 允许跨域的访问来源（多个用逗号分隔，建议改为实际访问地址）
CET_CORS_ALLOWED_ORIGINS=http://localhost:8080
